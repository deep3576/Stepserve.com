[flask]
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
secret_key = CHANGE_ME_TO_A_LONG_RANDOM_STRING
env = production
debug = false

[mysql]
# PythonAnywhere: host = <username>.mysql.pythonanywhere-services.com
host = 127.0.0.1
port = 3306
user = your_db_user
password = your_db_password
database = your_db_name
charset = utf8mb4

[email]
smtp_host = smtp.gmail.com
smtp_port = 587
smtp_user = your_email@gmail.com
smtp_password = your_gmail_app_password
from_email = StepServe <noreply@stepserve.com>
admin_notify = admin@stepserve.com
recipient = admin@stepserve.com

[api]
# Backend API base URL consumed by the Vite build — change to production URL for deployment
# PythonAnywhere example: https://youruser.pythonanywhere.com/api/v1
base_url = http://127.0.0.1:8000/api/v1

# Comma-separated list of allowed CORS origins (set your production domain(s) here)
# cors_origins = https://stepserve.ca,https://www.stepserve.ca
cors_origins = http://localhost:5173,http://localhost:5174

[stripe]
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_* / pk_test_* for testing, sk_live_* / pk_live_* for production
secret_key = sk_test_CHANGE_ME
publishable_key = pk_test_CHANGE_ME
webhook_secret = whsec_CHANGE_ME
# One-time $5 CAD listing fee — create in Stripe dashboard → Products
listing_price_id = price_CHANGE_ME

[security]
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
secret_key = CHANGE_ME_TO_A_LONG_RANDOM_STRING
# JWT token lifetime in minutes (default: 1440 = 24h)
access_token_expire_minutes = 1440

[rate_limits]
# Requests per minute per IP on public search/home endpoints
public_per_minute = 60
# Requests per hour per IP for auth registration
register_per_hour = 20
# Requests per minute per IP for auth login
login_per_minute = 10
# Requests per minute per IP for payment endpoints
payment_per_minute = 10
