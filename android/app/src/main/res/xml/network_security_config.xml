<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP to localhost/10.0.2.2 in debug builds so the app
  can reach the backend running on the development machine.
  Production builds use HTTPS and do not need this.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.0.168</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
